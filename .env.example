# Copy to .env.local (git-ignored). Never commit real values.
# Every key is validated in src/lib/env.ts. Keys are added as features need them.
#
# OPENROUTER_API_KEY=        # server-side only; all LLM / image / video calls go through OpenRouter (not wired yet)

# PostgreSQL connection string (local: Docker, see docker-compose.yml)
DATABASE_URL=

# S3-compatible object storage (local: MinIO). Server-only; never prefix with NEXT_PUBLIC_.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=

# Dev-only session: the org that requests act as. Ignored in production (see ADR 0002).
DEV_SESSION_ORG_ID=

# Inngest dev server (local). 1 = use the dev server, 0 = use Inngest Cloud keys.
INNGEST_DEV=1
